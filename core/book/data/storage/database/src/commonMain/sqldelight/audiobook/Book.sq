CREATE TABLE Book(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    folder_uri TEXT NOT NULL,
    folder_source_id INTEGER NOT NULL,
    sub_path TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL DEFAULT (strftime('%s','now')),
    total_duration_ms INTEGER NOT NULL DEFAULT 0,
    cover_uri TEXT,
    FOREIGN KEY (folder_source_id) REFERENCES FolderSource(id) ON DELETE CASCADE
);

insertBook:
INSERT INTO Book(title, folder_uri, folder_source_id, sub_path, total_duration_ms, cover_uri) VALUES(?, ?, ?, ?, ?, ?);

selectByFolderUriAndTitle:
SELECT id, title, folder_uri, sub_path, total_duration_ms, cover_uri
FROM Book
WHERE folder_uri = ? AND title = ?;

updateBookMetadata:
UPDATE Book SET sub_path = ?, total_duration_ms = ?, cover_uri = ?
WHERE id = ?;

selectBooksByFolderSourceId:
SELECT id, folder_uri, title
FROM Book
WHERE folder_source_id = ?;

selectIdByFolderSourceFolderUriTitle:
SELECT id
FROM Book
WHERE folder_source_id = ? AND folder_uri = ? AND title = ?
LIMIT 1;

deleteById:
DELETE FROM Book WHERE id = ?;

selectAllGlobal:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.total_duration_ms,
    b.cover_uri
FROM Book b
ORDER BY b.sub_path, b.title;

selectAllInSpace:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.total_duration_ms,
    COALESCE(p.listened_duration_ms, 0) AS listened_duration_ms,
    COALESCE(p.is_completed, 0) AS is_completed,
    b.cover_uri,
    COALESCE(p.hidden_from_continue, 0) AS hidden_from_continue
FROM Book b
INNER JOIN BookInSpace bis ON bis.book_id = b.id AND bis.space_id = ?
LEFT JOIN SpaceBookProgress p ON p.book_id = b.id AND p.space_id = ?
ORDER BY b.sub_path, b.title;

selectByFolderSource:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.cover_uri
FROM Book b
WHERE b.folder_source_id = ?
ORDER BY b.sub_path, b.title;

deleteByFolderSource:
DELETE FROM Book WHERE folder_source_id = ?;

lastInsertId:
SELECT last_insert_rowid();

selectRecentContinueListening:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.total_duration_ms,
    COALESCE(p.listened_duration_ms, 0) AS listened_duration_ms,
    COALESCE(p.is_completed, 0) AS is_completed,
    b.cover_uri,
    COALESCE(p.hidden_from_continue, 0) AS hidden_from_continue
FROM SpaceRecentBook r
INNER JOIN Book b ON b.id = r.book_id
INNER JOIN BookInSpace bis ON bis.book_id = b.id AND bis.space_id = r.space_id
LEFT JOIN SpaceBookProgress p ON p.book_id = b.id AND p.space_id = r.space_id
WHERE r.space_id = ?
  AND COALESCE(p.is_completed, 0) = 0
  AND COALESCE(p.hidden_from_continue, 0) = 0
  AND COALESCE(p.listened_duration_ms, 0) > 0
ORDER BY r.last_started_at DESC
LIMIT 50;

selectByIdInSpace:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.total_duration_ms,
    COALESCE(p.listened_duration_ms, 0) AS listened_duration_ms,
    COALESCE(p.is_completed, 0) AS is_completed,
    b.cover_uri,
    COALESCE(p.hidden_from_continue, 0) AS hidden_from_continue
FROM Book b
LEFT JOIN SpaceBookProgress p ON p.book_id = b.id AND p.space_id = ?
WHERE b.id = ?;

selectByIdGlobal:
SELECT b.id, b.title, b.folder_uri,
    (SELECT COUNT(*) FROM Chapter c WHERE c.book_id = b.id) AS chapter_count,
    b.sub_path,
    b.total_duration_ms,
    b.cover_uri
FROM Book b
WHERE b.id = ?;

updateBookCoverUri:
UPDATE Book SET cover_uri = ?
WHERE id = ? AND (cover_uri IS NULL OR cover_uri = '');

selectIdsBySubPath:
SELECT id FROM Book WHERE sub_path = ?;
